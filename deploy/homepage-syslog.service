[Unit]
Description=homepage syslog-ontvanger (udp/tcp 514)
After=network-online.target postgresql.service
Wants=postgresql.service

[Service]
User=homepage
Group=homepage
WorkingDirectory=/opt/homepage/backend
EnvironmentFile=/etc/homepage/homepage.env
ExecStart=/opt/homepage/.venv/bin/python -m app.syslog.server
Restart=always
RestartSec=5
# Poort 514 is een systeempoort.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/homepage /etc/homepage
# /var/lib/homepage-syslog, van de gebruiker homepage en ook met ProtectSystem=strict schrijfbaar: verlies dat bij
# het stoppen niet meer in de database raakte (database weg), tot de volgende start (HOMEPAGE_SYSLOG_STATE_FILE).
StateDirectory=homepage-syslog
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
