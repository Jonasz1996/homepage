[Unit]
Description=homepage: back-up van de database

[Service]
Type=oneshot
User=postgres
# Groep homepage: de worker mag de dumps lezen om te controleren of ze bruikbaar zijn.
Group=homepage
UMask=0027
# Zonder de logregels, de 5 nieuwste blijven (deploy/homepage-backup.sh).
ExecStart=/usr/local/sbin/homepage-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/homepage
