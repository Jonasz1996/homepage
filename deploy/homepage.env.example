# /etc/homepage/homepage.env (wordt door install.sh aangemaakt)
HOMEPAGE_DATABASE_URL=postgresql+asyncpg://homepage@/homepage?host=/var/run/postgresql
HOMEPAGE_SECRET_KEY_FILE=/etc/homepage/secret.key
HOMEPAGE_SETUP_TOKEN_FILE=/etc/homepage/setup-token
# Zet op false als je zonder HTTPS test (rechtstreeks http://IP). Achter NPM met HTTPS: true laten.
HOMEPAGE_COOKIE_SECURE=true
HOMEPAGE_SITE_NAME=homepage
