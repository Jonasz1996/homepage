  "short_name": "homepage",
  "description": "Homelab-dashboard",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#141414",
  "theme_color": "#141414",
  "lang": "nl",
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Tijdlijn", "url": "/?open=history", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Updates", "url": "/?open=updates", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Netwerk", "url": "/?open=network", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Terminal", "url": "/?open=terminal", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
